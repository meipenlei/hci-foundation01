      "afwEnbaleTlsForAllAppRules": {
        "value": "Audit"
      },
      "afwEnableTlsInspection": {
        "value": "Audit"
      },
      "afwEmptyIDPSBypassList": {
        "value": "Audit"
      },
      "afwEnableAllIDPSSignatureRules": {
        "value": "Audit"
      },
      "afwEnableIDPS": {
        "value": "Audit"
      },
      "wafAfdEnabled": {
        "value": "Audit"
      },
      "vpnAzureAD": {
        "value": "Audit"
      },
      "appGwTlsVersion": {
        "value": "Audit"
      },
      "modifyUdr": {
        "value": "Disabled"
      },
      "modifyUdrNextHopIpAddress": {
        "value": ""
      },
      "modifyUdrNextHopType": {
        "value": "None"

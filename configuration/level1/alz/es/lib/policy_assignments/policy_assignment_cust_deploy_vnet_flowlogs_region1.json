{
  "name": "CAF-Depl-VNet-FlowLogs1",
  "type": "Microsoft.Authorization/policyAssignments",
  "apiVersion": "2019-09-01",
  "properties": {
    "description": "Deploy if not exists VNet flowlogs and traffic analytics on network security groups. Define also the retention days.",
    "displayName": "CAF - Enable VNet flowlogs and traffic analytics.",
    "notScopes": [],
    "parameters": {
      "effect": {
        "value": "DeployIfNotExists"
      },
      "vnetRegion": {
        "value": "westeurope"
      },
      "flowAnalyticsEnabled": {
        "value": "true"
      },
      "interval": {
        "value": "60"
      },
      "logAnalytics": {
        "value": "/subscriptions/f371e124-4b06-46ea-9d63-f51d48d76e64/resourceGroups/hci01-rg-mgmt/providers/Microsoft.OperationalInsights/workspaces/hci01-log-logre1"
      },
      "retention": {
        "value": "2"
      },
      "storageAccountResourceId": {
        "value": "/subscriptions/f371e124-4b06-46ea-9d63-f51d48d76e64/resourceGroups/hci01-rg-nsgflogs1/providers/Microsoft.Storage/storageAccounts/hci01stnsgflogs1"
      }
    },
    "policyDefinitionId": "${root_scope_resource_id}/providers/Microsoft.Authorization/policyDefinitions/CAF-Deploy-VNet-FlowLogs",
    "scope": "${current_scope_resource_id}",
    "enforcementMode": "Default"
  },
  "location": "${default_location}",
  "identity": {
    "type": "SystemAssigned"
  }
}